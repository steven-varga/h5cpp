# =============================================================================
# Build directories
# =============================================================================
build/
build-*/
build_*/
out/
cmake-build-*/

# =============================================================================
# CMake-generated files (when cmake is run outside a build/ dir)
# =============================================================================
CMakeCache.txt
CMakeFiles/
CMakeLists.txt.user*
cmake_install.cmake
CTestTestfile.cmake
Testing/
_CPack_Packages/
install_manifest.txt
compile_commands.json

# Path-specific Makefile patterns — only the cmake-generated ones, leaving
# legit upstream Makefiles in doxy/, examples/half-float/, and the vendored
# zstd build scripts untouched. Added after an accidental in-source `cmake .`
# scattered "# CMAKE generated file" Makefiles across the source tree (see
# git history: "ignore in-source cmake Makefile pollution").
/thirdparty/Makefile
/thirdparty/*/Makefile
/thirdparty/dlib/v[0-9]*-build/
/thirdparty/blitz/v[0-9]*-build/
/bench/Makefile
/test/examples/Makefile
/examples/s3/Makefile

# =============================================================================
