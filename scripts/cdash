#!/usr/bin/env bash
# Submit h5cpp test results to CDash from any machine.
#
# Usage: scripts/cdash [KEY=value ...]
#
# Examples:
#   scripts/cdash
#   scripts/cdash TRACK=Nightly
#   scripts/cdash BUILD_TYPE=Debug HDF5_ROOT=/opt/hdf5
#   scripts/cdash CTEST_BUILD_NAME=linux-aarch64-gcc-13-Release
#   scripts/cdash BUILD_EXAMPLES=ON   # also build and test examples (needs armadillo/blaze/etc.)
#   scripts/cdash SUBMIT=OFF          # dry run: build+test, no upload
#   CXX=clang++-18 scripts/cdash
#
# All KEY=value pairs are forwarded to CTestDashboard.cmake as -DKEY=value.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

d_args=()
for arg in "$@"; do
    d_args+=("-D${arg}")
done

exec ctest -S "${SCRIPT_DIR}/CTestDashboard.cmake" "${d_args[@]}" -VV
