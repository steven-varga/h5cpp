# Doxyfile 1.9.x — H5CPP API reference
# Run from the doxy/ directory: doxygen Doxyfile
# Output lands in docs/doxygen/html/ (separate from MkDocs site/)

DOXYFILE_ENCODING      = UTF-8
PROJECT_NAME           = H5CPP
# Sourced at build time from the H5CPP_DOXYGEN_VERSION env var which
# scripts/docs-build.sh derives from the latest git tag (or, as a fallback,
# from the H5CPP_PROJECT_VERSION constant in the top-level CMakeLists.txt).
# Doxygen substitutes $(VAR) at parse time; an empty value renders as no
# number string, which is preferable to a stale literal.
PROJECT_NUMBER         = $(H5CPP_DOXYGEN_VERSION)
PROJECT_BRIEF          = "Modern C++ templates for HDF5 serial and parallel I/O"
PROJECT_LOGO           =
OUTPUT_DIRECTORY       = docs/doxygen
CREATE_SUBDIRS         = NO
ALLOW_UNICODE_NAMES    = NO
OUTPUT_LANGUAGE        = English

BRIEF_MEMBER_DESC      = YES
REPEAT_BRIEF           = YES
ALWAYS_DETAILED_SEC    = NO
INLINE_INHERITED_MEMB  = NO
FULL_PATH_NAMES        = NO

TAB_SIZE               = 4
MARKDOWN_SUPPORT       = YES
TOC_INCLUDE_HEADINGS   = 0
AUTOLINK_SUPPORT       = YES
BUILTIN_STL_SUPPORT    = NO
HIDE_UNDOC_MEMBERS     = YES
HIDE_UNDOC_CLASSES     = YES
HIDE_FRIEND_COMPOUNDS  = YES
HIDE_IN_BODY_DOCS      = YES
INTERNAL_DOCS          = NO
SHOW_INCLUDE_FILES     = NO
SORT_MEMBER_DOCS       = NO
GENERATE_TESTLIST      = NO
GENERATE_BUGLIST       = NO
GENERATE_DEPRECATEDLIST= NO
SHOW_FILES             = NO
SHOW_NAMESPACES        = NO

WARN_FORMAT            = "$file:$line: $text"
WARN_AS_ERROR          = NO
WARN_NO_PARAMDOC       = NO
# Emit warnings into a logfile alongside stderr so CI can upload it as an
# artifact for coverage-tracking visibility. The file lives in the build dir
# so it's picked up by the workflow's actions/upload-artifact step.
WARN_LOGFILE           = docs/doxygen/warnings.log

# Input: API headers + README as main page + local Doxygen pages +
# the curated reports tree + the alias-vocabulary reference. Conceptual
# guides with Material icons/images still live in MkDocs; Doxygen
# carries the API reference and the design/inventory prose that
# accompanies it.
INPUT                  = ../h5cpp \
                         docs/index.md \
                         docs/reports \
                         docs/curated \
                         docs/aliases.md \
                         ../examples \
                         .

FILE_PATTERNS          = *.cpp *.hpp *.h *.md *.dox
RECURSIVE              = YES

EXCLUDE                = docs/doxygen
# ../examples/ is added to INPUT only so README.md files become Doxygen
# pages. Exclude the example *source* files from INPUT scanning — they're
# already handled as `\example` listings via EXAMPLE_PATH below and shouldn't
# be parsed as regular API source (that would surface example-internal
# main() functions and helpers as documented entities, polluting the index).
EXCLUDE_PATTERNS       = */thirdparty/* \
                         */examples/*.cpp \
                         */examples/*.hpp \
                         */examples/*.h \
                         */examples/*/*.cpp \
                         */examples/*/*.hpp \
                         */examples/*/*.h \
                         */examples/*/CMakeLists.txt \
                         */examples/*/Makefile

# Drop the h5::impl::* implementation namespace AND the h5::error::*
# exception hierarchy from documentation entirely. With Classes /
# Namespaces tabs hidden in DoxygenLayout.xml, documented-but-unnested
# structs still leak into the root of navtreedata.js as bare entries
# (rollback / any / open / close / read / write / create / misc /
# delete_ for each error category). Excluding the symbols here keeps
# them out of the nav while the structs remain valid C++ to throw/catch.
EXCLUDE_SYMBOLS        = h5::impl::* \
                         h5::error::* \
                         h5::pod \
                         h5::strlen \
                         h5::has_scatter \
                         h5::gorilla \
                         h5::uniform \
                         h5::normal \
                         h5::exponential \
                         h5::bernoulli

EXAMPLE_PATH           = ../examples/attributes \
                         ../examples/basics \
                         ../examples/compound \
                         ../examples/container \
                         ../examples/cout \
                         ../examples/csv \
                         ../examples/custom-pipeline \
                         ../examples/datasets \
                         ../examples/datatypes \
                         ../examples/groups \
                         ../examples/half-float \
                         ../examples/linalg \
                         ../examples/mdspan \
                         ../examples/mpi \
                         ../examples/multi-tu \
                         ../examples/optimized \
                         ../examples/packet-table \
                         ../examples/pprint \
                         ../examples/raw_memory \
                         ../examples/reference \
                         ../examples/reflection \
                         ../examples/s3 \
                         ../examples/smart-ptr \
                         ../examples/sparse \
                         ../examples/stl \
                         ../examples/string \
                         ../examples/transform \
                         ../examples/utf
EXAMPLE_PATTERNS       = *.cpp *.hpp *.h
EXAMPLE_RECURSIVE      = YES

USE_MDFILE_AS_MAINPAGE = docs/index.md

# Index and layout
ALPHABETICAL_INDEX     = NO
LAYOUT_FILE            = DoxygenLayout.xml

# HTML output
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
HTML_HEADER            = header.html
HTML_FOOTER            = footer.html
HTML_EXTRA_STYLESHEET  = doxygen-awesome.css customdoxygen.css
HTML_EXTRA_FILES       = doxygen-awesome-darkmode-toggle.js \
                         doxygen-overload-collapse.js
HTML_COLORSTYLE_HUE    = 28
HTML_COLORSTYLE_SAT    = 150
HTML_COLORSTYLE_GAMMA  = 80
HTML_TIMESTAMP         = NO
HTML_DYNAMIC_SECTIONS  = NO
HTML_INDEX_NUM_ENTRIES = 100

GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
ENUM_VALUES_PER_LINE   = 4

# No LaTeX
GENERATE_LATEX         = NO

# Tag files for cross-links
TAGFILES              += "docs/tags/cppreference-doxygen-web.tag.xml=https://en.cppreference.com/"

# Alias includes — each file adds ALIASES lines
@INCLUDE_PATH          = docs/links
@INCLUDE               = h5cpp.txt
@INCLUDE               = hdf5.txt
@INCLUDE               = linalg.txt
@INCLUDE               = stl.txt

# Preprocessor — used so that SFINAE return-type macros collapse to the
# advertised return type in the rendered signature while the real compile
# still resolves the std::enable_if_t<...> form. Headers gate the swap on
# the H5CPP_DOXYGEN sentinel and list the macros that should be expanded
# inline in signatures via EXPAND_AS_DEFINED.
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED            += H5CPP_DOXYGEN=1
EXPAND_AS_DEFINED     += H5CPP_ATTR_CREATE_RET
EXPAND_AS_DEFINED     += H5CPP_ATTR_OPEN_RET
EXPAND_AS_DEFINED     += H5CPP_ATTR_DELETE_RET
EXPAND_AS_DEFINED     += H5CPP_ATTR_READ_RET
EXPAND_AS_DEFINED     += H5CPP_ATTR_WRITE_RET
